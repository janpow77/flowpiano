<Application x:Class="FlowPiano.Windows.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlowPiano.Windows.App"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <local:DegreeToColorConverter x:Key="DegreeToColor" />
    <local:ExerciseResultToColorConverter x:Key="ResultToColor" />
    <local:InversionToLabelConverter x:Key="InversionToLabel" />
    <local:PitchClassToGermanNameConverter x:Key="PitchClassToGerman" />
    <local:DiatonicChordDisplayConverter x:Key="DiatonicChordDisplay" />
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
  </Application.Resources>
</Application>
